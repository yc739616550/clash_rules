[custom]

; ======================
; 规则说明
; ======================
; 目标：
; 1. 只有一个日本节点
; 2. 国内直连
; 3. 国外走日本 VPS
; 4. OffSec VPN 强制走代理
; 5. HTB VPN TCP / UDP 强制走代理
; 6. 避免非标端口规则影响 VPN

; ======================
; 本地 / 私有地址直连
; ======================
ruleset=全球直连,[]GEOSITE,private
ruleset=全球直连,[]GEOIP,private,no-resolve

; ======================
; VPS 本身直连，避免代理回环
; 你的日本 VPS：43.167.18.247
; ======================
ruleset=全球直连,[]IP-CIDR,43.167.18.247/32,no-resolve

; ======================
; OffSec VPN 强制走日本 VPS
; 必须放在国内直连、非标端口、漏网之鱼之前
; ======================
ruleset=实验室VPN,[]DOMAIN,vpn-pool2.offseclabs.com
ruleset=实验室VPN,[]DOMAIN-SUFFIX,offseclabs.com
ruleset=实验室VPN,[]DOMAIN-SUFFIX,offsec.com
ruleset=实验室VPN,[]DOMAIN-SUFFIX,offensive-security.com

; ======================
; HTB VPN 强制走日本 VPS
; UDP: edge-sg-free-2.hackthebox.eu:1337
; TCP: edge-sg-free-2.hackthebox.eu:443
; ======================
ruleset=实验室VPN,[]DOMAIN,edge-sg-free-2.hackthebox.eu
ruleset=实验室VPN,[]DOMAIN-SUFFIX,hackthebox.eu
ruleset=实验室VPN,[]DOMAIN-SUFFIX,hackthebox.com
ruleset=实验室VPN,[]DOMAIN-SUFFIX,htb-cloud.com
ruleset=实验室VPN,[]DOMAIN-KEYWORD,hackthebox

; ======================
; 自定义直连规则
; ======================
ruleset=全球直连,clash-domain:https://testingcf.jsdelivr.net/gh/Aethersailor/Custom_OpenClash_Rules@main/rule/Custom_Direct_Domain.yaml,28800
ruleset=全球直连,clash-classic:https://testingcf.jsdelivr.net/gh/Aethersailor/Custom_OpenClash_Rules@main/rule/Custom_Direct_Classical_IP.yaml,28800

; ======================
; 自定义代理规则
; ======================
ruleset=手动选择,clash-domain:https://testingcf.jsdelivr.net/gh/Aethersailor/Custom_OpenClash_Rules@main/rule/Custom_Proxy_Domain.yaml,28800
ruleset=手动选择,clash-classic:https://testingcf.jsdelivr.net/gh/Aethersailor/Custom_OpenClash_Rules@main/rule/Custom_Proxy_Classical_IP.yaml,28800

; ======================
; 国内服务直连
; ======================
ruleset=全球直连,[]GEOSITE,google-cn
ruleset=全球直连,[]GEOSITE,category-games@cn
ruleset=全球直连,clash-classic:https://testingcf.jsdelivr.net/gh/Aethersailor/Custom_OpenClash_Rules@main/rule/Steam_CDN_Classical.yaml,28800
ruleset=全球直连,[]GEOSITE,category-game-platforms-download
ruleset=全球直连,[]GEOSITE,category-public-tracker

; ======================
; 常见国外服务走代理
; 只有一个日本节点，所以统一走“手动选择”
; ======================
ruleset=手动选择,[]GEOSITE,category-communication
ruleset=手动选择,[]GEOSITE,category-social-media-!cn
ruleset=手动选择,[]GEOSITE,openai
ruleset=手动选择,[]GEOSITE,category-ai-!cn
ruleset=手动选择,[]GEOSITE,github
ruleset=手动选择,[]GEOSITE,category-speedtest
ruleset=手动选择,[]GEOSITE,steam
ruleset=手动选择,[]GEOSITE,youtube
ruleset=手动选择,[]GEOSITE,apple-tvplus
ruleset=手动选择,[]GEOSITE,microsoft
ruleset=手动选择,[]GEOSITE,googlefcm
ruleset=手动选择,[]GEOSITE,google
ruleset=手动选择,[]GEOSITE,tiktok
ruleset=手动选择,[]GEOSITE,netflix
ruleset=手动选择,[]GEOSITE,disney
ruleset=手动选择,[]GEOSITE,hbo
ruleset=手动选择,[]GEOSITE,primevideo
ruleset=手动选择,[]GEOSITE,spotify
ruleset=手动选择,[]GEOSITE,bahamut
ruleset=手动选择,[]GEOSITE,category-games
ruleset=手动选择,[]GEOSITE,category-entertainment
ruleset=手动选择,[]GEOSITE,category-ecommerce
ruleset=手动选择,[]GEOSITE,gfw

; ======================
; 常见国外 IP 规则走代理
; ======================
ruleset=手动选择,[]GEOIP,telegram,no-resolve
ruleset=手动选择,[]GEOIP,twitter,no-resolve
ruleset=手动选择,[]GEOIP,facebook,no-resolve
ruleset=手动选择,[]GEOIP,google,no-resolve
ruleset=手动选择,[]GEOIP,netflix,no-resolve

; ======================
; 国内兜底直连
; ======================
ruleset=全球直连,[]GEOSITE,cn
ruleset=全球直连,[]GEOIP,cn,no-resolve

; ======================
; 注意：
; 不再启用“非标端口直连”
; 因为 OffSec UDP 1194、HTB UDP 1337 都是非标端口
; 开启后容易破坏 VPN 走代理策略
; ======================

; ======================
; 最终兜底
; ======================
ruleset=漏网之鱼,[]FINAL


; ======================
; 节点分组
; ======================

; 只有一个日本节点，所以自动选择直接匹配全部节点
custom_proxy_group=♻️ 自动选择`url-test`.*`https://cp.cloudflare.com/generate_204`300,,50

; 手动选择：可选自动、日本节点、直连、全部节点
custom_proxy_group=手动选择`select`[]♻️ 自动选择`[]全球直连`.*

; 实验室 VPN：只允许走代理，不给 DIRECT，避免误点直连
custom_proxy_group=实验室VPN`select`[]♻️ 自动选择`.*

; 全球直连
custom_proxy_group=全球直连`select`[]DIRECT

; 漏网之鱼
custom_proxy_group=漏网之鱼`select`[]手动选择`[]♻️ 自动选择`[]全球直连`.*


; ======================
; 规则生成设置
; ======================
enable_rule_generator=true
overwrite_original_rules=true
